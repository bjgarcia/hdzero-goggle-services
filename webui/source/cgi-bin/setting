# common functions

# Returns a line with line number of a named section
get_section_line() {
   local line=
   local cnt=`expr $(sed -n "/\[$1\]/{=;q;}" "$SETTING_PATH")`
   echo "$(sed -n "/\[$1\]/,/\[/p" "$SETTING_PATH" | grep -v "\[[A-Z]*[a-z]*\]")" | { 
   while read line; do
   #echo "rsl: $line cnt: $cnt 1: $1 2: $2 3: $3" >> debug
   cnt=`expr $cnt + 1`
   if [ -n "$2" ] && echo "$line" | grep -q "$2"; then
     echo "$line=$cnt"
     break;
   fi
   done
   }   
}

# Return last section line number or zero
get_section_last_line() { 
   local line=
   local cnt=$(sed -n "/\[$1\]/{=;q;}" "$SETTING_PATH")
   if [ -z "$cnt" ]; then
      cnt=0
   fi
   echo $(sed -n "/\[$1\]/,/\[/p" "$SETTING_PATH" | grep -v "\[[A-Z]*[a-z]*\]") | {
   while read line; do
      if [ "$cnt" -gt 0 ]; then
         cnt=`expr $cnt + 1`
      fi
   done
   echo "$cnt"
   }
}

# Handlers

# get file
on_settings() {
    utils_content_json
    #utils_is_action_authorized "${HTTP_COOKIE#token=}"
    if test -f ${SETTING_PATH}; then
       cnt=0
       body="{\"sections\":[{\"section\":"
       while read line; do
	 cnt=`expr $cnt + 1`
         if [ ! -z "${line}" ]; then
	    IFS="="; set -- $line
	    if [ ! -z "$1" ] && [ ! -z "$2" ]; then
               # settings
	       setting="${setting}{\"key\":\"${1}\", \"value\":\"${2}\", \"ln\": \"${cnt}\"},"
            elif [ ! -z "$1" ] && [ $cnt -gt 1 ]; then
               # sections
               setting="${setting%?}"
               body="${body}\"${section}\":[$setting],"
               section=$(echo "$1" | sed 's/[][]//g')
               setting=
            else
	        # first section
                section=$(echo "$1" | sed 's/[][]//g')
                body="${body}\"${section}\","
            fi
	 fi
	done < "$SETTING_PATH"
	setting="${setting%?}"
	echo "${body}\"${section}\":[$setting]}]}"
   else
      utils_print_error "Status: 404 Not Found" "Error: file: \"$SETTING_PATH\" not found."
   fi
}

# get line
on_line_read() {
  utils_content_json
  #utils_is_action_authorized "${HTTP_COOKIE#token=}"
  if test -f ${SETTING_PATH}; then
     section="$1" 
     line=$(get_section_line $1 $2)
     IFS="="; set -- $line
     if [ ! -z "$1" ] && [ ! -z "$2" ]; then
        setting="{\"key\": \"${1}\", \"value\": \"${2}\", \"line\": \"${3}\"}"
     else
        utils_print_error "Status: 500" "section \"$1\", line: \"$2\" does not exist."
     fi
     echo "{\"section\":\"${section}\",\"setting_list\":[$setting]}"
  else
     utils_print_error "Status: 404 Not Found" "Error: file: \"$SETTING_PATH\" not found."
  fi
}

# get section
on_section_read() {
  utils_content_json
  #utils_is_action_authorized "${HTTP_COOKIE#token=}"
  if test -f ${SETTING_PATH}; then
     section="$1" 
     cnt=$(sed -n "/\[$2\]/{=;q;}" "$SETTING_PATH")     
     echo $(sed -n "/\[$1\]/,/\[/p" "$SETTING_PATH" | grep -v "\[[A-Z]*[a-z]*\]") | { 
       while read line; do
          cnt=`expr $cnt + 1`
          IFS="="; set -- $line
          setting="${setting}{\"key\": \"${1}\", \"value\": \"${2}\", \"line\": \"${cnt}\"},"
       done 
       setting="${setting%?}"
       echo "{\"section\":\"${section}\",\"setting_list\":[$setting]}"
     }
  else
      utils_print_error "Status: 404 Not Found" "Error: file: \"$SETTING_PATH\" not found."
  fi
}

# new line 
on_line_post() {
   #utils_is_action_authorized "${HTTP_COOKIE:w#token=}"
   if test -f ${SETTING_PATH}; then
      setting="$1"
      json_str=$(echo "$POST_DATA" | ./json.sh -l) # parse post  
      IFS=","; set -- $(echo $json_str | head -1 | sed 's/\["\(.*\)"\]\t"\(.*\)"/\1,\2/') 
      json_str="{\"section\":\"${2}\",\"setting_list\":["
      pos=$(sed -n "/\[$2\]/{=;q;}" "$SETTING_PATH")
      section=$2
      if [ -n "$pos" ]; then # section exists 
         line=$(get_section_line "$section" "$setting")
         IFS="="; set -- $line
         if [ -z "$3" ]; then # after last line 
            pos=$(get_section_last_line "$section")
         fi
	 cnt=0
         echo $(echo "$POST_DATA" | ./json.sh -l | awk 'NR>1') | { while read setting; do 
            line=$(echo $setting | sed 's/^.*,"\([a-zA-Z]*\)"\]\t"\([a-zA-Z0-9]*\)"$/\1,\2/') 
            OIFS=$IFS;IFS=","; set -- $line
            case "$1" in 
               key) key=$2 ;;
             value) value=$2;;
            esac
            IFS=$OIFS
            cnt=`expr $cnt + 1`
            res=`expr $cnt % 3`
            if [ $res -eq 0 ]; then
              line=$(get_section_line "$section" "$key")
              if [ -z "$line" ]; then
                res=$(wc -l < "$SETTING_PATH")
                OIFS=$IFS;IFS=","; set -- $line
                if [ "$pos" -lt "$res" ]; then
                   pos=`expr $pos + 1`
                   json_str="${json_str}{\"key\":\"${key}\",\"value\":\"${value}\",\"line\":\"${pos}\"},"
		   sed -i "${pos}i ${key}=${value}" "$SETTING_PATH"
	        else
                  pos=`expr $pos + 1`
		  json_str="${json_str}{\"key\":\"${key}\",\"value\":\"${value}\",\"line\":\"${pos}\"},"
                  echo  "${key}=${value}" >> "$SETTING_PATH"
	        fi
                IFS=$OIFS
              else
                 utils_print_error "Status: 400 Bad Request" "Error: Line: \"$line\" already exists." 
              fi 
           fi
	 done
         utils_content_json
         echo "${json_str%,}]"
         }
      else
        utils_print_error "Status: 400 Bad Request" "Error: Section: \"$section\" does not exist."
      fi
   else  
      utils_print_error "Status: 404 Not Found" "Error: file: \"$SETTING_PATH\" not found."
   fi
}

# new section
