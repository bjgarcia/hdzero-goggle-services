      json_str="{\"section\":\"${2}\",\"setting_list\":["
      pos=$(sed -n "/\[$2\]/{=;q;}" "$SETTING_PATH")
      setting="$2"
      if [ -z "$pos" ]; then # not exists 
         pos=$(get_section_last_line "$section")
         lln=$(wc -l < "$SETTING_PATH")
         if [ "$pos" -lt "$lln" ] && [ "$pos" -ne 0 ]; then
            pos=`expr $pos + 1`
            sed -i "${pos}i \[${setting}\]" "$SETTING_PATH"
	 else
            pos=`expr $lln + 1`
	    echo "[${setting}]" >> "$SETTING_PATH"
	 fi
         utils_content_json
         echo "${json_str%,}]"
      else
         utils_print_error "Status: 400 Bad Request" "Error: Section: \"$setting\" already exists."
      fi
   else  
      utils_print_error "Status: 404 Not Found" "Error: file: \"$SETTING_PATH\" not found."
   fi
}

