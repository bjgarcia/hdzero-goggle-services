# Delete line 
on_line_delete() {
  #UTILs_is_action_authorized "${HTTP_COOKIE#token=}"
  if test -f ${SETTING_PATH}; then
      setting=$(echo "$POST_DATA" | ./json.sh -l) # parse post  
      IFS=","; set -- $(echo "$setting" | head -1 | sed 's/\["\(.*\)"\]\t"\(.*\)"/\1,\2/') 
      json_str="{\"section\":\"${2}\",\"setting_list\":["
      pos=$(sed -n "/\[$2\]/{=;q;}" "$SETTING_PATH")
      section="$2"
      cnt=0
      if [ -n "$pos" ]; then # section exists
         echo $(echo "$setting" | awk 'NR>1') | { while read line; do
            cnt=`expr $cnt + 1`
            if [ `expr $cnt % 3` -eq 1 ]; then
               set -- $(echo $line | sed 's/^.* [0-9] "\([a-zA-Z]*\)"\]\t"\([a-zA-Z:0-9]*\)"$/\1,\2/') 
                  data="$data$2,"
            fi
         done
	 for key in ${data%,}; do
            line=$(get_section_line "$section" "$key")
            if [ -n "$line" ]; then
               OIFS=$IFS;IFS="="; set -- $line
               json_str="${json_str}{\"key\": \"${1}\", \"value\": \"${2}\", \"line\": \"${3}\"},"
               IFS=$OIFS
            fi
         done 
	 for key in ${data%,}; do
            line=$(get_section_line "$section" "$key")
            if [ -n "$line" ]; then
               OIFS=$IFS;IFS="="; set -- $line
               sed -i "${3}d" "${SETTING_PATH}"
               IFS=$OIFS
            else
               utils_print_error "Status: 400 Bad Request" "Error: key: \"$key\" does not exist."
            fi
         done
         utils_content_json
         echo "$json_str"
         }
      else
         utils_print_error "Status: 400 Bad Request" "Error: Section: \"$section\" does not exist."
      fi
  else
     utils_print_error "Status: 404 Not Found" "Error: file: \"$SETTING_PATH\" not found."
  fi
}

# Delete section 
on_section_delete() {
  #UTILs_is_action_authorized "${HTTP_COOKIE#token=
  if test -f ${SETTING_PATH}; then
      json_str=$(echo "$POST_DATA" | ./json.sh -l) # parse post  
      IFS=","; set -- $(echo $json_str | head -1 | sed 's/\["\(.*\)"\]\t"\(.*\)"/\1,\2/') 
      json_str="{\"section\":\"${2}\",\"setting_list\":["
      pos=$(sed -n "/\[$2\]/{=;q;}" "$SETTING_PATH")
      cnt=$pos
      section="$2"
      if [ -n "$pos" ]; then # section exists
         echo $(sed -n "/\[$section\]/,/\[/p" "$SETTING_PATH" | grep -v "\[[A-Z]*[a-z]*\]") | { 
         while read line; do
            cnt=`expr $cnt + 1`
            OIFS=$IFS;IFS="="; set -- $line
            json_str="${json_str}{\"key\": \"${1}\", \"value\": \"${2}\", \"line\": \"${cnt}\"},"
            IFS=$OIFS
         done 
         sed -i "${pos},${cnt}d" "${SETTING_PATH}" 
         utils_content_json
         echo "${json_str%,}]"
         } 
      else
         utils_print_error "Status: 400 Bad Request" "Error: Section: \"$section\" does not exist."
      fi
  else
     utils_print_error "Status: 404 Not Found" "Error: file: \"$SETTING_PATH\" not found."
  fi
}

echo "qs: $QUERY_STRING" > debug
echo "req: $REQUEST_METHOD" >> debug

# Parse Request
if [ -z $QUERY_STRING ]; then
   on_settings
else
    IFS="&"
    set -- $QUERY_STRING
    key="${1%=*}"
    if [ "$REQUEST_METHOD" = "GET" ]; then
       if [ ${key} = "section" -a "${2%=*}" = "line" ]; then
	  on_line_read "${1#*=}" "${2#*=}" 
       elif [ ${key} = "section" ]; then
          on_section_read "${1#*=}"
       else
          utils_print_error "Status: 421 Misdirected Request" "Use only line, section or null."
       fi
    elif [ "$REQUEST_METHOD" = "POST" ]; then
       if [ "$CONTENT_LENGTH" -gt 0 ] && [ -z "${CONTENT_TYPE##*"application/json"*}" ]; then
          POST_DATA=`cat /dev/stdin`
          case ${key} in
          put)
              if [ ${1#*=} = "line" ]; then
                 on_line_put 
              elif [ ${1#*=} = "section" ]; then
                 on_section_put 
              else
                 utils_print_error "Status: 421 Misdirected Request" "Use only line, section or file."
              fi
            ;;
          post)
	     if [ ${1#*=} = "line" ]; then
                on_line_post "${2#*=}" 
	     elif [ ${1#*=} = "section" ]; then
                on_section_post "${2#*=}"
             else
               utils_print_error "Status: 421 Misdirected Request" "Use only line, section or null."
             fi
            ;;
          patch)
              if [ ${1#*=} = "line" ]; then
                 on_line_patch 
              else
                 utils_print_error "Status: 421 Misdirected Request" "Use only line"
              fi
            ;;
          delete)
              if [ ${1#*=} = "line" ]; then
                 on_line_delete
              elif [ ${1#*=} = "section" ]; then
                 on_section_delete
              else
                 utils_print_error "Status: 421 Misdirected Request" "Use only line."
              fi
            ;;
          *)
              utils_print_error "Status: 421 Misdirected Request" "Use only put, post, patch, delete."
           ;;
         esac
       else
          utils_print_error "Status: 501 Not Implemented" "Only application/json excepted."
       fi
    else
       utils_print_error "Status: 501 Not Implemented" "Method is not recognized. Use only GET or POST."
    fi
fi

